# Copy to .env and fill in. Never commit .env.
# Everything marked REQUIRED is needed for the default matrix (config/matrix.yaml).

# ---------------------------------------------------------------- models
# REQUIRED. Google AI Studio key (https://aistudio.google.com/apikey).
# Used for: Gemini 4 Carbon + Hydrogen (the agent LLMs), Gemini Decision 1
# (decision model), the tau-bench user simulator and the judges (via LiteLLM,
# which reads this same variable). Carbon has no free tier: use a paid project.
GEMINI_API_KEY=

# REQUIRED for the "jev" condition: ONE of these two.
# TypeSafe direct (preferred, no gateway hop): POST https://api.typesafe.ai/v1/systemone,
# model jev-1.14.0. Used automatically when this is set and OPENROUTER_API_KEY is empty.
TYPESAFE_API_KEY=
# Or Jev through OpenRouter's Decisions API (model typesafe/jev-1.14).
OPENROUTER_API_KEY=
# Optional overrides for the direct route.
JEV_BASE_URL=
JEV_MODEL=

# REQUIRED for the "subq" condition. SubQ Snap 1.2 (https://docs.subq.ai).
SUBQ_API_KEY=

# Optional. Only if you want tau-bench's official OpenAI judges instead of the
# Gemini judge override (see config/matrix.yaml -> benchmarks.tau.judge_llm).
OPENAI_API_KEY=

# ---------------------------------------------------------------- storage
# REQUIRED for the dashboard to read from Tiger Data. Tiger Cloud service
# connection string (Tiger console -> service -> Connect). Must include sslmode.
# Leave empty to fall back to the local TimescaleDB container
# (docker compose --profile localdb) or to JSONL files only.
DATABASE_URL=

# ---------------------------------------------------------------- observability
# Optional but needed for the Sentry raffle: project DSN (Sentry -> Project
# Settings -> Client Keys).
SENTRY_DSN=
SENTRY_ENVIRONMENT=hackathon

# ---------------------------------------------------------------- benchmarks
# MedAgentBench FHIR server. In docker compose this is the "fhir" service.
FHIR_API_BASE=http://fhir:8080/fhir/
# tau-bench data folder (set by scripts/setup_benchmarks.sh layout).
TAU2_DATA_DIR=/app/vendor/tau2-bench/data
# Where the benchmark repos live (scripts/setup_benchmarks.sh clones them here).
VENDOR_DIR=/app/vendor

# ---------------------------------------------------------------- run controls
# Hard spend cap for one run, in USD. The runner stops submitting work past it.
BUDGET_USD=150
# Optional basic-auth password for the dashboard (user: jev). Empty = open.
DASHBOARD_PASSWORD=

# ---------------------------------------------------------------- deploy only
# DigitalOcean personal access token. Only for scripts/do_create_droplet.sh,
# doctl and the DigitalOcean MCP server. The benchmark itself does not need it.
DIGITALOCEAN_API_TOKEN=
